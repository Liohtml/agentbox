{
  "name": "@liohtml/agentbox",
  "version": "0.1.0",
  "description": "One-command, Docker-isolated agentic coding sandbox: tmux + Claude Code (Agent Teams) + web Observer.",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "agentbox": "bin/agentbox.mjs"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "CONTRACT.md"
  ],
  "scripts": {
    "agentbox": "tsx src/index.ts",
    "doctor": "tsx src/index.ts doctor",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agent-teams",
    "sandbox",
    "docker",
    "tmux",
    "agentic",
    "cli",
    "coding-agent",
    "devcontainer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liohtml/agentbox.git"
  },
  "homepage": "https://github.com/Liohtml/agentbox#readme",
  "bugs": {
    "url": "https://github.com/Liohtml/agentbox/issues"
  },
  "author": "Liohtml",
  "license": "MIT",
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
